# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional. For sending real ticket emails via Resend (https://resend.com)
RESEND_API_KEY=""

# RESEND_FROM_EMAIL: The sender email for approved tickets
RESEND_FROM_EMAIL="Jailer 2 Premiere <onboarding@resend.dev>"

# ADMIN_INIT_PASSWORD: Optional custom initial password for the admin account
ADMIN_INIT_PASSWORD=""
